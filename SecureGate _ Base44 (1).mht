.prose-editor .ql-snow.ql-toolbar button:hover .ql-stroke, .prose-editor .ql-snow.ql-toolbar button.ql-active .ql-stroke, .prose-editor .ql-snow .ql-picker-label:hover .ql-stroke { stroke: var(--sem-text-icon-primary); }

.prose-editor .ql-snow.ql-toolbar button:hover .ql-fill, .prose-editor .ql-snow.ql-toolbar button.ql-active .ql-fill { fill: var(--sem-text-icon-primary); }

.prose-editor .ql-snow .ql-picker-options { background: var(--sem-surface-surface-sunken); border: 1px solid var(--sem-border-separator-light); border-radius: var(--radius-lg); font-family: var(--font-body); color: var(--sem-text-icon-primary); }
