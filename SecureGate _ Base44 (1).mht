.prose-editor .ql-snow .ql-picker-label { padding: var(--space-1) var(--space-2); font-family: var(--font-body); font-size: var(--fs-small); color: var(--sem-text-icon-primary); }

.prose-editor .ql-snow.ql-toolbar button, .prose-editor .ql-snow .ql-picker-label { border-radius: var(--radius-md); }

