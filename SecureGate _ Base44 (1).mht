.prose-editor .ql-container { font-family: var(--font-body); font-size: var(--fs-medium); line-height: var(--lh-7); color: var(--sem-text-icon-primary); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.prose-editor .ql-editor { min-height: 600px; padding: var(--space-6) var(--space-16) var(--space-12) var(--space-16); }

.prose-editor .ql-editor.ql-blank::before { color: var(--sem-text-icon-secondary); font-style: normal; }

.prose-editor .ql-editor h1, .prose-editor .ql-editor h2, .prose-editor .ql-editor h3 { font-family: var(--font-titles); font-weight: var(--fw-semibold); color: var(--sem-text-icon-primary); }

