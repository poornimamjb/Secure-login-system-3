.prose-editor .ql-editor h3 { font-size: var(--fs-h3); line-height: var(--lh-7); margin-top: var(--space-6); margin-bottom: var(--space-2); }

.prose-editor .ql-editor p { margin-bottom: var(--space-4); }

.prose-editor .ql-editor ul, .prose-editor .ql-editor ol { margin-bottom: var(--space-4); padding-left: var(--space-6); }

.prose-editor .ql-editor li { margin-bottom: var(--space-2); }

.prose-editor .ql-editor h1, .prose-editor .ql-editor h2, .prose-editor .ql-editor h3, .prose-editor .ql-editor p, .prose-editor .ql-editor li { text-align: start; unicode-bidi: plaintext; }

